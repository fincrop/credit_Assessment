# Agri-Credit Pipeline — Python API / worker environment template
# Copy to `backend/Credit_assessment/.env` (same directory as main.py).
# Never commit real secrets.
#
# Run from this directory:
#   ../../.conda/python.exe -m uvicorn api.app:app --host 127.0.0.1 --port 8000 --reload
#   ../../.conda/python.exe worker.py

# --- Mongo (required for jobs / farm_info) ---
MONGODB_URI=mongodb+srv://USER:PASS@HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=agristack

# --- Python API / worker ---
CROP_MODEL_PATH=models/crop_classifier_tier1_v1.joblib
ML_MODE=rule_based
USE_MONGODB=true
PIPELINE_VERBOSE=false
# Requires xgboost + scikit-learn (see requirements.txt). Set false to skip ML crop ID.
ENABLE_CROP_CLASSIFICATION=true
API_SERVICE_KEY=
CORS_ORIGINS=*
EXPOSE_INTERNAL_ERRORS=0
SATELLITE_PROVIDER=gee
SATELLITE_FORCE_FRESH=false
SATELLITE_CACHE_TTL_DAYS=30
# FIELD_BUFFER_LEGACY=1   # restore 0.5 km point buffer floor
AI_ENRICHMENT_ENABLE=true
JOB_RUNNING_TIMEOUT_MINUTES=45

# GEE (when SATELLITE_PROVIDER=gee) — prefer env over a key file
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_B64=
# GEE_SERVICE_ACCOUNT_JSON=
# Relative paths resolve against backend/Credit_assessment/
GEE_SA_KEY_PATH=api/gee_service_account.json

# Optional AI enrichment. Groq runs automatically when GROQ_API_KEY is set.
# Set GROQ_ENABLE=false to keep the key but skip LLM calls.
GROQ_API_KEY=
# GROQ_ENABLE=false
# Leave unset to use the in-code default. Only pin a model here if you have
# checked it is still served — a retired id fails every call and falls back to
# the deterministic report with only a log line.
GROQ_MODEL=llama-3.3-70b-versatile
# Per-request timeout (s) and retry count. Worst-case added latency inside an
# assessment is roughly GROQ_TIMEOUT * (GROQ_MAX_RETRIES + 1) plus backoff.
GROQ_TIMEOUT=20
GROQ_MAX_RETRIES=1
SARVAM_API_KEY=
