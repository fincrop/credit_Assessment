# Agri-Credit Pipeline — Python API / worker environment template
# Copy to `backend/Credit_assessment/.env` (same directory as main.py).
# Never commit real secrets.
#
# Run from this directory:
#   uvicorn api.app:app --host 0.0.0.0 --port 8000 --reload
#   python worker.py

# --- Mongo (required for jobs / farm_info) ---
MONGODB_URI=mongodb+srv://USER:PASS@HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=agristack

# --- Python API / worker ---
CROP_MODEL_PATH=models/crop_classifier_model.joblib
ML_MODE=rule_based
USE_MONGODB=true
PIPELINE_VERBOSE=false
ENABLE_CROP_CLASSIFICATION=false
API_SERVICE_KEY=
CORS_ORIGINS=*
EXPOSE_INTERNAL_ERRORS=0
SATELLITE_PROVIDER=gee
SATELLITE_FORCE_FRESH=false
SATELLITE_CACHE_TTL_DAYS=30
# FIELD_BUFFER_LEGACY=1   # restore 0.5 km point buffer floor
AI_ENRICHMENT_ENABLE=true
JOB_RUNNING_TIMEOUT_MINUTES=45

# GEE (when SATELLITE_PROVIDER=gee) — prefer env over a key file
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_B64=
# GEE_SERVICE_ACCOUNT_JSON=
# Relative paths resolve against backend/Credit_assessment/
GEE_SA_KEY_PATH=api/gee_service_account.json

# Optional AI enrichment
GROQ_API_KEY=
GROQ_ENABLE=false
GROQ_MODEL=llama-3.1-70b-versatile
SARVAM_API_KEY=
