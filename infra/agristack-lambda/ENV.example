# Mumbai AgriStack Lambda — set these in AWS Lambda → Configuration → Environment variables
#
# LAMBDA_PUBLIC_BASE_URL must be a PLAIN URL (no markdown [text](url) wrappers).

MONGODB_URI=mongodb+srv://USER:PASS@HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=agristack
LAMBDA_PUBLIC_BASE_URL=https://YOUR_ID.lambda-url.ap-south-1.on.aws

# Gate Token/Seek/KDSS actions (Next sends header x-agristack-proxy-secret).
# Must match frontend AGRISTACK_PROXY_SECRET. Do NOT require this on webhook paths.
AGRISTACK_PROXY_SECRET=change-me-long-random-shared-with-frontend

# Optional: only if AgriStack can send the same header on callbacks
# WEBHOOK_SECRET=

# Upstream AgriStack HTTP timeout (ms). Seek is often slow; keep Lambda timeout ≥ 60s.
# Default in code is 45000. Set this in AWS if you have not redeployed yet.
AGRISTACK_FETCH_TIMEOUT_MS=45000

# Frontend (frontend/.env.local) companion keys:
# AGRISTACK_PROXY_URL=https://YOUR_ID.lambda-url.ap-south-1.on.aws
# AGRISTACK_PROXY_SECRET=<same as above>
# NEXT_PUBLIC_APP_DOMAIN=https://YOUR_ID.lambda-url.ap-south-1.on.aws
