# Agri-Credit Pipeline — environment index
# Never commit real secrets.
#
# Python API / worker:
#   Copy backend/Credit_assessment/.env.example → backend/Credit_assessment/.env
#
# Next.js frontend:
#   Copy the frontend section below (or see comments in
#   backend/Credit_assessment/.env.example) into frontend/.env.local

# --- Frontend (frontend/.env.local) ---
MONGODB_URI=mongodb+srv://USER:PASS@HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=agristack
PIPELINE_API_URL=http://127.0.0.1:8000
# PIPELINE_API_SERVICE_KEY=
AUTH_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000
# WEBHOOK_SECRET=

# LGD villages/talukas (one-time):
#   cd frontend
#   npm run lgd:build-json
#   npm run lgd:import-villages

# NEXT_PUBLIC_AGRISTACK_CLIENT_ID=registry_sandbox
# NEXT_PUBLIC_AGRISTACK_USERNAME=
# NEXT_PUBLIC_AGRISTACK_PASSWORD=
