# Copy to ".env" for local development (never commit .env).
# On Render: set these in the dashboard Environment tab.

# --- Required for API + CLI when using MongoDB ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?appName=YourApp
# Optional database name (default: agricultural_credit_db)
# MONGODB_DATABASE=agricultural_credit_db

# --- API service (optional hardening) ---
# If set, clients must send header: X-API-Key: <same value>
# API_SERVICE_KEY=

# --- Pipeline ---
CROP_MODEL_PATH=models/crop_classifier_model.joblib
ML_MODE=rule_based
USE_MONGODB=true
PIPELINE_VERBOSE=false

# --- CORS (frontend origin(s), comma-separated; * = allow all) ---
CORS_ORIGINS=*

# --- AI enrichment (optional) ---
# GROQ_ENABLE=0
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-70b-versatile
# SARVAM_API_KEY=

# --- Debug ---
# EXPOSE_INTERNAL_ERRORS=0
