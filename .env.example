# Agri-Credit Pipeline — environment index
# Never commit real secrets.
#
# Python API / worker:
#   Copy backend/Credit_assessment/.env.example → backend/Credit_assessment/.env
#
# Next.js frontend:
#   Copy the frontend section below into frontend/.env.local
#
# Mumbai AgriStack Lambda:
#   See infra/agristack-lambda/ENV.example (set the same PROXY secret on Lambda + frontend)

# --- Frontend (frontend/.env.local) ---
MONGODB_URI=mongodb+srv://USER:PASS@HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=agristack
PIPELINE_API_URL=http://127.0.0.1:8000
# PIPELINE_API_SERVICE_KEY=
AUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_SECRET=change-me-to-a-long-random-string
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# AgriStack webhooks + Seek sender_uri base (Mumbai Lambda Function URL, no trailing slash)
NEXT_PUBLIC_APP_DOMAIN=https://YOUR_ID.lambda-url.ap-south-1.on.aws

# Route Token / Seek / KDSS through Mumbai Lambda (required outside India / on Render)
AGRISTACK_PROXY_URL=https://YOUR_ID.lambda-url.ap-south-1.on.aws
AGRISTACK_PROXY_SECRET=change-me-long-random-shared-with-lambda

# Optional: only if AgriStack can send x-webhook-secret (usually leave unset)
# WEBHOOK_SECRET=

# AgriStack login is entered in the /agristack UI (session-only).
# Optional server-only notes for local convenience — NEVER use NEXT_PUBLIC_* for passwords:
# AGRISTACK_CLIENT_ID=registry_sandbox
# AGRISTACK_USERNAME=
# AGRISTACK_PASSWORD=

# LGD villages/talukas (one-time):
#   cd frontend
#   npm run lgd:build-json
#   npm run lgd:import-villages
