# Agri-Credit Pipeline — environment template
# Copy to `.env` (repo root, Python) and/or `frontend/.env.local` (Next.js).
# Never commit real secrets.

# --- Mongo (required for jobs / farm_info) ---
MONGODB_URI=mongodb+srv://USER:PASS@HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=agristack

# --- Python API / worker ---
CROP_MODEL_PATH=models/crop_classifier_model.joblib
ML_MODE=rule_based
USE_MONGODB=true
PIPELINE_VERBOSE=false
ENABLE_CROP_CLASSIFICATION=false
API_SERVICE_KEY=
CORS_ORIGINS=*
EXPOSE_INTERNAL_ERRORS=0
SATELLITE_PROVIDER=gee
SATELLITE_FORCE_FRESH=false
SATELLITE_CACHE_TTL_DAYS=30

# GEE (when SATELLITE_PROVIDER=gee) — prefer env over a key file
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_B64=
# GEE_SERVICE_ACCOUNT_JSON=
# GEE_SA_KEY_PATH=

# Optional AI enrichment
GROQ_API_KEY=
GROQ_ENABLE=false
GROQ_MODEL=llama-3.1-70b-versatile
SARVAM_API_KEY=

# --- Frontend (frontend/.env.local) ---
# PIPELINE_API_URL=http://127.0.0.1:8000
# PIPELINE_API_SERVICE_KEY=
AUTH_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000
# Optional: gate AgriStack webhook POSTs (header x-webhook-secret)
# WEBHOOK_SECRET=
# Sandbox token form defaults (leave empty and paste in UI if preferred)
# NEXT_PUBLIC_AGRISTACK_CLIENT_ID=registry_sandbox
# NEXT_PUBLIC_AGRISTACK_USERNAME=
# NEXT_PUBLIC_AGRISTACK_PASSWORD=
